		"speedlify2-score": "^1.1.0"
	},
	"engines": {
		"node": ">=20"
	},
	"private": true,
	"devDependencies": {
		"@11ty/eleventy": "4.0.0-alpha.10",
		"@11ty/eleventy-activity-feed": "^2.0.0",
		"@11ty/eleventy-fetch": "^6.0.1",
		"@11ty/eleventy-img": "7.1.1",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@11ty/eleventy-plugin-webc": "^0.12.0-beta.8",
		"@11ty/font-awesome": "^2.0.0",
		"@11ty/gray-matter": "^3.0.0",
		"@11ty/image-color": "^2.1.0",
		"@11ty/import": "^3.0.0-beta.8",
		"@tweetback/canonical": "^2.0.49",
		"degit": "^3.10.1",
		"dotenv": "^18.0.9",
		"fast-glob": "^3.3.3",
		"html-entities": "^2.6.0",
		"kleur": "^4.1.5",
		"lightningcss": "^1.33.0",
		"lodash": "^4.18.1",
		"luxon": "^3.7.2",
		"markdown-it": "^15.0.3",
		"memoize": "^11.0.0",
		"netlify-plugin-cache": "^1.0.3",
		"numeral": "^2.0.6",
		"pagefind": "^1.5.2",
		"sanitize-html": "^2.18.1",
		"youtube-transcript": "1.3.1"
	},
	"scripts": {
		"clean": "rm -rf _site && rm -rf .cache",
		"check-links": "npx check-html-links _site",
		"create-search-index": "npx pagefind --site \"_site\" --glob \"{web,resume}/**/*.html\"",
		"build": "npx @11ty/eleventy",
		"start": "npx @11ty/eleventy --serve --port=8090 --incremental",
		"start-search": "npm run build && npm run create-search-index && npm run start",
		"import:projects": "./fetch-projects.sh",
		"import:analytics": "node fetch-analytics-data.js",
		"import:webmentions": "node _11ty/webmentions/import.js",
		"production": "npm run import:projects && npm run build-production && npm run create-search-index",
		"nocache-production": "npm run import:projects && npm run build-production && npm run create-search-index",
		"build-production": "PRODUCTION_BUILD=true npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/zachleat/zachleat.com.git"
	},
	"author": "Zach Leatherman",
	"license": "MIT"
