		"@zachleat/carouscroll": "^1.0.6",
		"@zachleat/details-utils": "^3.0.0",
		"@zachleat/filter-container": "^4.0.0",
		"@zachleat/flex-luthor": "^4.0.2",
		"@zachleat/fundraising-status": "^1.0.6",
		"@zachleat/heading-anchors": "^1.0.5",
		"@zachleat/icon-fall": "^1.0.0",
		"@zachleat/line-numbers": "^1.0.3",
		"@zachleat/pagefind-search": "^1.0.3",
		"@zachleat/snow-fall": "^1.0.3",
		"@zachleat/solar-eclipse-toggle": "^2.2.1",
		"@zachleat/squirminal": "^3.0.1",
		"@zachleat/table-of-contents": "^2.0.0",
		"@zachleat/table-saw": "^1.0.7",
