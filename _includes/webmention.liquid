<li class="static-comments-reply u-comment h-cite" id="webmention-{{ webmention['wm-id'] }}">
  {%- capture missingEmoji %}<span class="static-comments-missing-emoji" title="Missing emoji" role="img" aria-label="Missing emoji">{% icon "fas:clipboard-question" %}</span>{% endcapture %}
  {%- capture mentionLinkIcon %}{% icon "fas:user" %}{% endcapture %}
  {%- assign isOriginalPoster = webmention | webmentionIsOriginalPoster %}
  <div class="static-comments-hed">
    {%- include "webmention-avatar.liquid" %}

    <div class="static-comments-title p-name cased">{% if webmention.author.name != "" %}{{ webmention.author.name | remove: ":11ty:" | strip | htmlEntities | replace: "????", missingEmoji }}{% elsif webmention.url %}<em>{{ webmention.url | hostnameFromUrl }}</em>{% else %}Anonymous{% endif %}<!-- <a href="#webmention-{{ webmention['wm-id'] }}" class="static-comments-selflink exempt">🔗</a>--></div>
    {% if isOriginalPoster %}<span class="static-comments-mention static-comments-op">OP</span>{% endif %}

    {% if webmention.published %}
      <em class="static-comments-date">
        {%- assign platformIcon = webmention | webmentionPlatformIcon %}
        {%- if webmention.url != "" %}<a class="h-card u-url favicon-optout" href="{{ webmention.url }}" target="_blank" rel="noopener noreferrer">{% endif -%}
        {% icon platformIcon %}<time-difference relative-to="{{ page.date | dateToISO }}" mode="strip-prefix" suffix=" after post"><time class="dt-published" datetime="{{ webmention.published }}" title="{{ webmention.published | readableDateFromISO }}">{{ webmention.published | readableDateFromISO: "dd LLL yyyy" }}</time></time-difference>
        {%- if webmention.url != "" %}</a>{% endif -%}
        {%- for crosspost in webmention.crossposts %}
        {%- assign crosspostIcon = crosspost | webmentionPlatformIcon %}
        <a class="favicon-optout" href="{{ crosspost.url }}" target="_blank" rel="noopener noreferrer">{% icon crosspostIcon %}<time-difference relative-to="{{ page.date | dateToISO }}" mode="strip-prefix" suffix=" after post"><time datetime="{{ crosspost.published }}" title="{{ crosspost.published | readableDateFromISO }}">{{ crosspost.published | readableDateFromISO: "dd LLL yyyy" }}</time></time-difference></a>
        {%- endfor %}
      </em>
    {% endif %}
  </div>

  {% if webmention['wm-property'] == "repost-of" or webmention['wm-property'] == "like-of" or webmention['wm-property'] == "bookmark-of" %}
  {% elsif webmention['content-hidden'] %}
  <div class="static-comments-msg"><p><em>This post is only visible on {{ webmention | webmentionPlatformName }}.</em></p></div>
  {% else %}
  <div class="static-comments-msg p-content"><p>
    {%- if webmention.published %}{% elsif webmention.url != "" %}
    <a class="h-card u-url" href="{{ webmention.url }}" target="_blank" rel="noopener noreferrer">Show original post</a>
    {% endif -%}
    {{ webmention.content.text | escape | webmentionMentionPills: webmention.isNested, webmention, replies, mentionLinkIcon | replace: "????", missingEmoji }}
  </p></div>
  {% endif %}

  {% if webmention['other-media'] and webmention['content-hidden'] != true %}
  <div class="static-comments-msg static-comments-other-media"><p><em>Includes media only visible on {{ webmention | webmentionPlatformName }}.</em></p></div>
  {% endif %}

  {% if webmention.images.size > 0 %}
  <div class="static-comments-photos">
    {%- for image in webmention.images %}
    <label class="static-comments-photo">
      <input type="checkbox" class="sr-only">
      <img src="{{ image.thumb | escape }}" alt="{{ image.alt | escape }}" loading="lazy" decoding="async" eleventy:ignore>
      <span class="static-comments-photo-reveal">Show image</span>
    </label>
    {%- endfor %}
  </div>
  {% endif %}

  {% if showTarget %}
  <a href="{{ webmention['wm-target'] }}" class="tag-inline tag-cased">{{ webmention['wm-target'] | localUrl }}</a>
  {% endif %}
  {% if webmention.replies.size > 0 %}
  {%- capture replyList %}
  <ol>
  {% for reply in webmention.replies %}
    {% include "webmention", webmention: reply %}
  {% endfor %}
  </ol>
  {%- endcapture %}
  {%- assign replyCount = webmention | threadReplyCount %}
  {% if webmention.isNested or replyCount == 1 %}
  {{ replyList }}
  {% else %}
  <details class="static-comments-thread">
    <summary><span class="static-comments-thread-faces">{% assign replyAuthors = webmention | threadReplyAuthors %}{% for reply in replyAuthors limit: 5 %}{% render "webmention-avatar.liquid", webmention: reply, imageClass: "static-comments-thread-face" %}{% endfor %}</span>Show {{ replyCount }} replies</summary>
    {{ replyList }}
  </details>
  {% endif %}
  {% endif %}
</li><!-- /static-comments-reply -->
