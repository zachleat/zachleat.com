<li class="static-comments-reply u-comment h-cite" id="webmention-{{ webmention['wm-id'] }}">
  {%- capture missingEmoji %}<span class="static-comments-missing-emoji" title="Missing emoji" role="img" aria-label="Missing emoji">{% icon "fas:clipboard-question" %}</span>{% endcapture %}
  {%- assign isOriginalPoster = webmention | webmentionIsOriginalPoster %}
  <div class="static-comments-hed">
    {%- include "webmention-avatar.liquid" %}

    <div class="static-comments-title p-name cased">{% if webmention.author.name != "" %}{{ webmention.author.name | remove: ":11ty:" | strip | htmlEntities | replace: "????", missingEmoji }}{% elsif webmention.url %}<em>{{ webmention.url | hostnameFromUrl }}</em>{% else %}Anonymous{% endif %}<!-- <a href="#webmention-{{ webmention['wm-id'] }}" class="static-comments-selflink exempt">🔗</a>--></div>
    {% if isOriginalPoster %}<span class="static-comments-mention static-comments-op">OP</span>{% endif %}

    {% if webmention.published %}
      <em class="static-comments-date">
        {%- assign platformIcon = webmention | webmentionPlatformIcon %}
        {%- if webmention.url != "" %}<a class="h-card u-url favicon-optout" href="{{ webmention.url }}" target="_blank" rel="noopener noreferrer">{% endif -%}
        {% icon platformIcon %}<time-difference relative-to="{{ page.date | dateToISO }}" mode="strip-prefix" suffix=" later"><time class="dt-published" datetime="{{ webmention.published }}" title="{{ webmention.published | readableDateFromISO: "dd LLL yyyy" }}">{{ webmention.published | readableDateFromISO: "dd LLL yyyy" }}</time></time-difference>
        {%- if webmention.url != "" %}</a>{% endif -%}
      </em>
    {% endif %}
  </div>

  {% if webmention['wm-property'] == "repost-of" or webmention['wm-property'] == "like-of" or webmention['wm-property'] == "bookmark-of" %}
  {% elsif webmention.content.text.length <= 5000 %}
  <div class="static-comments-msg p-content{% if webmention.content.text.length > 5000 %} static-comments-msg-long{% endif %}"><p>
    {%- if webmention.published %}{% elsif webmention.url != "" %}
    <a class="h-card u-url" href="{{ webmention.url }}" target="_blank" rel="noopener noreferrer">Show original post</a>
    {% endif -%}
    {{ webmention.content.text | escape | truncate | webmentionMentionPills | replace: "????", missingEmoji }}
  </p></div>
  {% endif %}

  {% if showTarget %}
  <a href="{{ webmention['wm-target'] }}" class="tag-inline tag-cased">{{ webmention['wm-target'] | localUrl }}</a>
  {% endif %}
  {% if webmention.replies.size > 0 %}
  <ol>
  {% for reply in webmention.replies %}
    {% include "webmention", webmention: reply %}
  {% endfor %}
  </ol>
  {% endif %}
</li><!-- /static-comments-reply -->
