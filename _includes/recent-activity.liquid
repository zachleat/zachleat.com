{%- assign recentActivity = webmentions | webmentionsRecentActivity: 4, trafficSpikes %}
{%- if recentActivity.size > 0 %}
	<div class="rail-activity hide-singlecol">
		<div class="top5 rail-activity-hed">Recent Activity{%- assign webmentionsTotalCount = webmentions | webmentionsTotalCount %}<span class="rail-activity-count" title="{{ webmentionsTotalCount | renderNumber }} webmentions tracked">{% icon "fas:chart-line" %}{{ webmentionsTotalCount | renderNumber: "0.0a" }}</span></div>
		<ol class="activity-feed list-flush favicon-optin">
		{%- for activity in recentActivity %}
			{% include "webmention-activity.liquid" %}
		{%- endfor %}
		</ol>
	</div>
{%- endif %}
