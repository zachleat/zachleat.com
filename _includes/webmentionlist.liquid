<div class="webmentions content-grid-sibling" id="webmentions" data-pagefind-ignore>
  {%- assign replies = webmentions | webmentionsForUrl: absoluteUrl, 'in-reply-to' | webmentionMergeCrossposts -%}
  {% assign disqusCommentSize = 0 %}
  {% if disqus %}{% assign disqusCommentSize = disqus.commentCount %}{% endif %}
  {%- assign repliesSize = replies | size | plus: disqusCommentSize -%}
	{%- assign syndications = webmentions | webmentionSyndication: absoluteUrl, false %}
	{%- if syndications.size > 0 %}
	<div class="syndication">
	<div class="hed-h3">Reply to…</div>
	<div class="syndication-cards">
		{%- for post in syndications %}
		{%- assign platformIcon = post | webmentionPlatformIcon %}
		<a href="{{ post.url }}" class="syndication-card u-syndication" target="_blank" rel="noopener noreferrer">
			<span class="syndication-card-hed">
				<img class="syndication-card-avatar" src="{{ post.author.photo | eleventyImageServiceAvatar }}" alt="" width="36" height="36" loading="lazy" decoding="async" eleventy:ignore>
				<span class="syndication-card-author">
					<strong>{{ post.author.name | htmlEntities }}</strong>
					<span class="syndication-card-meta"><time datetime="{{ post.published }}">{{ post.published | readableDateFromISO: "dd LLL yyyy" }}</time>{% if post['social-replies'] != nil %} · {{ post['social-replies'] }} repl{% if post['social-replies'] == 1 %}y{% else %}ies{% endif %}{% endif %}</span>
				</span>
				<span class="syndication-card-platform">{% icon platformIcon %}<span class="a11y-only">{{ post | webmentionPlatformName }}</span></span>
			</span>
			{%- if post.content.text %}
			<span class="syndication-card-text text-ellipsis-multi">{{ post.content.text | escape }}</span>
			{%- endif %}
		</a>
		{%- endfor %}
	</div>
	</div>
	{%- endif %}

  {% if repliesSize > 0 %}
  {%- assign threads = replies | webmentionThreads -%}
  {%- assign threadsSize = disqus.comments | size | plus: threads.size -%}
  <div id="comments">
    <div class="hed-h3">{{ repliesSize }} Comment{% if repliesSize != 1 and repliesSize != "1" %}s{% endif %}{% if threadsSize > 1 %} in {{ threadsSize }} Threads{% endif %}</div>
    {%- assign visibleThreads = 6 -%}
    {%- if threadsSize < 12 %}{% assign visibleThreads = threadsSize %}{% endif -%}
    {%- assign disqusVisible = visibleThreads | minus: threads.size | at_least: 0 -%}
    {%- assign olderThreadsSize = threadsSize | minus: visibleThreads -%}
    <ol class="static-comments static-comments-webmentions favicon-optin">
      {% for webmention in threads limit: visibleThreads %}
        {% include "webmention" %}
      {% endfor %}
    </ol>

    <ol class="static-comments favicon-optin">
    {% for comment in disqus.comments limit: disqusVisible %}
      {% include "comment-entry.html" %}
    {% endfor %}
    </ol>

    {% if olderThreadsSize > 0 %}
    <details class="static-comments-older">
      <summary>Show {{ olderThreadsSize }} older thread{% if olderThreadsSize != 1 %}s{% endif %}</summary>
      <ol class="static-comments static-comments-webmentions favicon-optin">
        {% for webmention in threads offset: visibleThreads %}
          {% include "webmention" %}
        {% endfor %}
      </ol>

      <ol class="static-comments favicon-optin">
      {% for comment in disqus.comments offset: disqusVisible %}
        {% include "comment-entry.html" %}
      {% endfor %}
      </ol>
    </details>
    {% endif %}
  </div>
  {% endif %}

  {% comment %}Note thie combines both repost and mention, similar to how Twitter now combines retweet and quote tweet{% endcomment %}
  {%- assign reposts = webmentions | webmentionsForUrl: absoluteUrl, "repost-of,mention-of" -%}
  {%- assign repostsSize = reposts | size -%}
  {%- assign likes = webmentions | webmentionsForUrl: absoluteUrl, 'like-of' -%}
  {%- assign likesSize = likes | size -%}
  {% if repostsSize > 0 %}
  <div class="webmentions__facepile">
    <div class="hed-h3{% if repostsSize > 11 or likesSize > 11 %} webmentions__facepile__hedlg{% endif %}">{{ repostsSize }} Repost{% if repostsSize != 1 %}s{% endif %}</div>
    {%- for webmention in reposts -%}
      <span>{% render "webmention-avatar.liquid", webmention: webmention, imageClass: "webmentions__face" %}</span>
    {%- endfor -%}
  </div>
  {% endif %}

  {% if likesSize > 0 %}
  <div class="webmentions__facepile">
    <div class="hed-h3{% if repostsSize > 11 or likesSize > 11 %} webmentions__facepile__hedlg{% endif %}">{{ likesSize }} Like{% if likesSize != 1 %}s{% endif %}</div>
    {%- for webmention in likes -%}
      <span>{% render "webmention-avatar.liquid", webmention: webmention, imageClass: "webmentions__face" %}</span>
    {%- endfor -%}
  </div>
  {% endif %}

  {%- assign bookmarks = webmentions | webmentionsForUrl: absoluteUrl, 'bookmark-of' -%}
  {%- assign bookmarksSize = bookmarks | size -%}

  {% if bookmarksSize > 0 %}
  <div class="webmentions__facepile">
    <div class="hed-h3{% if bookmarksSize > 11 %} webmentions__facepile__hedlg{% endif %}">{{ bookmarksSize }} Bookmark{% if bookmarksSize != 1 %}s{% endif %}</div>
    {%- for webmention in bookmarks -%}
      {%- if webmention.url != "" -%}
      <a class="h-card u-url" href="{{ webmention.url }}" target="_blank" rel="noopener noreferrer">
      {%- endif -%}
      {% render "webmention-avatar.liquid", webmention: webmention, imageClass: "webmentions__face" %}
      {%- if webmention.url != "" -%}
      </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {% endif %}
</div>