---
layout: layouts/base.liquid
classes:
  html: page-gradient
  body: body-grid
modules:
  - "/static/heading-anchors.js"
  - "/static/js/time-difference.js"
tocSidebar: true
appendix: false
enableWebmentions: true
ba_kickstarter_url: https://www.kickstarter.com/projects/fontawesome/build-awesome-pro?ref=43ttgb
---
<a href="#skiplink-content" id="skiplink-top" class="skiplink skiplink-fn" data-pagefind-ignore>Skip to Content</a>
<div class="rail" data-pagefind-ignore>
	<header class="rail-header">
		<a href="/" class="header">
			<img src="/img/avatar-2025-green-cover.png" alt="Zach’s ugly mug (his face)" class="my-avatar" loading="eager" fetchpriority="high">
			<span class="hed-h1">Zach Leat&shy;herman</span>
		</a>
		{% include "social.html" %}
	</header>
	<aside>
		<nav role="navigation">
			<div class="navigation">
				<ul class="list-flush tags-rail-links">
					<li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>{% icon "fa:house" %}Home</a></li>
					<li><a href="/about/" {% if page.url == '/about/' %}class="active"{% endif %}>{% icon "fa:user" %}About</a></li>
					<li><a href="/web/" {% if page.url == '/web/' %}class="active"{% endif %}>{% icon "fa:book" %}Archives</a></li>
					<li><a href="/projects/" {% if page.url == '/projects/' %}class="active"{% endif %}>{% icon "fa:diagram-project" %}Projects</a></li>
					<li><a href="/web/eleventy/" {% if page.url == '/web/eleventy/' %}class="active"{% endif %}>{% icon "fab:build-awesome" %}<span class="a11y-only-sm">Build Awesome </span>{% icon "fab:eleventy" %}</a></li>
					<li><a href="/web/speaking/" {% if page.url == '/web/speaking/' %}class="active"{% endif %}>{% icon "fa:microphone-lines" %}Speaking</a></li>
					<li class="hide-singlecol"><a href="/uses/" {% if page.url == '/uses/' %}class="active"{% endif %}>{% icon "fa:gear" %}Uses</a></li>
					<li class="hide-singlecol"><a href="/domains/" {% if page.url == '/domains/' %}class="active"{% endif %}>{% icon "fa:signature" %}Domains</a></li>
					{% comment %} <li><a href="/web/research/" class="tag{% if page.url == '/web/research/' %} active{% endif %}">Research</a></li> {% endcomment %}
					{% comment %} <li><a href="/web/citations/" class="tag{% if page.url == '/web/citations/' %} active{% endif %}">Citations</a></li> {% endcomment %}
				</ul>

				<a href="/web/" class="spark hide-singlecol">
					<span>2007</span>
					{%- capture sparklineHistoryValues %}{{ collections.posts | getMonthlyPostCount }}{% endcapture %}
					<div><img src="{% sparklineDataUri sparklineHistoryValues, 120, 30, '#94b388' %}" width="120" height="30" alt="Sparkline representing frequency of posts written from 2007 to {{ currentYear }}" loading="lazy" decoding="async" class="spark-img" eleventy:ignore></div>
					<span>{{ currentYear }}</span>
				</a>

				<div class="tags tags-rail tags-rail-top5 hide-singlecol">
				{%- if collections.pinnedPosts | size %}
					<div>
						<div class="top5 icon-override">PIN{% icon "fa:thumbtack" %}</div>
						{%- for post in collections.pinnedPosts limit:1 %}
							<a href="{{ post.url }}" class="tag tag-popular-rail tag-pinned-rail tag-borderless">{{ post.data.title }}</a>
						{%- endfor %}
					</div>
				{%- endif %}

				{%- if hidePostsInSidebar != true %}
					<div>
						<div class="top5"><a href="/web/best-of/">Popular{% icon "fas:fire-flame-curved" %}</a></div>

						{% for post in collections.popularPostsRanked limit:4 %}
						<a href="{{ post.url }}" class="tag tag-popular-rail tag-borderless">{{ post.data.title }}</a>
						{% endfor %}
					</div>
				{%- endif %}
				</div>
			</div>
		</nav>
	</aside>
{%- capture railSyndicationUrl %}{{ page.url | absoluteUrl }}{% endcapture %}
{%- assign railSyndications = webmentions | webmentionSyndication: railSyndicationUrl %}
{%- if appendix == "post" %}
	{%- assign railOlderPost = collections.activePosts | getNextCollectionItem: page %}
	{%- assign railNewerPost = collections.activePosts | getPreviousCollectionItem: page %}
{%- endif %}
{%- if railSyndications.size > 0 or tocSidebar or railOlderPost or railNewerPost %}
	<div class="rail-sticky hide-singlecol">
	{%- if railOlderPost or railNewerPost %}
		<nav class="rail-nextprev-wrap" aria-label="More posts">
			<ul class="rail-nextprev list-flush">
			{%- if railOlderPost %}
				<li><span class="rail-nextprev-label">{% icon "fas:arrow-left" %}Older</span><a href="{{ railOlderPost.url }}" class="rail-nextprev-card"><strong class="text-ellipsis-multi">{{ railOlderPost.data.title }}</strong></a></li>
			{%- endif %}
			{%- if railNewerPost %}
				<li class="rail-nextprev-newer"><span class="rail-nextprev-label">Newer{% icon "fas:arrow-right" %}</span><a href="{{ railNewerPost.url }}" class="rail-nextprev-card"><strong class="text-ellipsis-multi">{{ railNewerPost.data.title }}</strong></a></li>
			{%- endif %}
			</ul>
		</nav>
	{%- endif %}
	{%- if railSyndications.size > 0 %}
		<div class="rail-syndication-wrap">
			<div class="top5">Reply to…</div>
			<ul class="rail-syndication list-flush">
			{%- for post in railSyndications %}
				{%- assign platformIcon = post | webmentionPlatformIcon %}
				<li><a href="{{ post.url }}" class="rail-syndication-card{% if platformIcon == "fab:hacker-news" %} rail-syndication-card--hn{% endif %}" target="_blank" rel="noopener noreferrer">{% icon platformIcon %}<strong>{{ post | webmentionPlatformName }}</strong>{% if post['story-points'] %}{% if post['story-comments'] > post['story-points'] %}<span>{{ post['story-comments'] }} comment{% if post['story-comments'] != 1 %}s{% endif %}</span>{% else %}<span>{{ post['story-points'] }} upvote{% if post['story-points'] != 1 %}s{% endif %}</span>{% endif %}{% else %}<time datetime="{{ post.published }}">{{ post.published | readableDateFromISO: "dd LLL yyyy" }}</time>{% endif %}</a></li>
			{%- endfor %}
			</ul>
		</div>
	{%- endif %}
	{%- if tocSidebar %}
		<nav class="rail-toc" aria-labelledby="rail-toc-title">
			<is-land on:visible import="/static/table-of-contents.js">
				<table-of-contents selector="{{ tocSelector | default: 'main :is(h2, h3)' }}">
					<div class="top5" id="rail-toc-title">On this Page</div>
				</table-of-contents>
			</is-land>
		</nav>
	{%- endif %}
	</div>
{%- endif %}
</div>
<main class="content-main" data-role="main" id="skiplink-content">
	{{ content }}
</main><!-- /.content -->
{% include "appendix.liquid" %}
{% include "footer.html" %}

<div>
	{% getBundle "fontawesome" %}
</div>

{% comment %} if you remove this, re-enable in 2023-12-15-snow-fall.md {% endcomment %}
{% comment %} <is-land on:media="(prefers-reduced-motion: no-preference)">
	<template data-island="once">
		<script type="module" src="/static/snow-fall.js"></script>
	</template>
	<snow-fall></snow-fall>
</is-land> {% endcomment %}

<div class="hamburger">
	<is-land on:idle on:visible on:media="(prefers-reduced-motion: no-preference) and (min-width: 61.1875em)" import="/static/infinity-burger.js">
		<infinity-burger theme-fn></infinity-burger>

		<template data-island="once">
			<style>
			/* Desktop only, for extra laughs */
			@media (max-width: 61.1875em) { /* 979px */
				infinity-burger {
					display: none;
				}
			}
			</style>
{%- if JS_ENABLED %}
			<script>
			function InfinityBurgerColor(count) {
				return `hsl(${count * 5 % 360}, 100%, 50%)`
			}
			</script>
{%- endif %}
		</template>
	</is-land>
</div>
