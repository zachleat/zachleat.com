---
layout: layouts/default.liquid
tmpl: list
tocSelector: ".layout-list > article :is(h2, h3)"
---
<div class="layout-list">
	<article>
		<h1 class="primary-title{% if titleScreenReaderOnly %} sr-only{% endif %}">{{ title }}</h1>
		<heading-anchors selector="h2,h3">
			{{ content }}
		</heading-anchors>
	</article>
</div><!-- /.layout-list -->