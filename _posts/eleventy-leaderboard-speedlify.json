		},
		{
			"id": 1522804,
			"parentId": 0,
			"url": "https://twitter.com/eleven_ty/status/1571914587846414340",
			"author": {
				"name": "Eleventy 🎈",
				"url": "https://twitter.com/eleven_ty",
				"avatarUrl": "https://avatars.webmention.io/pbs.twimg.com/761cab6131337cc6c2ca3c4d237f1ee5516b3237dbd29ec63c211a9fb54687f4.jpg"
			},
			"date": "2022-09-19T17:30:17.000Z",
			"content": "You can read about the tiebreakers here: <a href=\"https://www.zachleat.com/web/eleventy-leaderboard-speedlify/#%22the-algorithm%22-and-tiebreaker-changes\">zachleat.com/web/eleventy-l…</a>\n\nLarger sites are rewarded in the ranking algorithm.\n<a class=\"u-mention\" href=\"https://twitter.com/GaryLake\"></a>\n<a class=\"u-mention\" href=\"https://twitter.com/felixvhagen\"></a>",
			"type": "reply",
			"via": "webmention"
		},
		{
